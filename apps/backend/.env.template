STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# LOCAL-DEV ONLY values. In production the server REFUSES TO BOOT if
# JWT_SECRET / COOKIE_SECRET are unset (medusa-config.ts requireSecret) —
# there is no "supersecret" fallback outside local dev. Set real values in
# the Railway service environment.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Supabase access for the LMS module's lab-handoff path. SERVICE_ROLE
# bypasses RLS — necessary because the lab handoff happens server-side
# in trusted Medusa workflows, not from a customer-scoped session.
# The decrypt_with_vault_key RPC + AES vault key live on the
# Supabase side; this server only needs the URL + key to call into them.
# RPC name: decrypt_with_vault_key(ciphertext text, key_alias text)
# Key alias used by LMS: "prescription_master_key" (see VAULT_KEYS).
# SUPABASE_SERVICE_ROLE_KEY takes a Supabase secret key (sb_secret_...),
# one per service, so a leak only forces one rotation. The legacy JWT
# service_role key (eyJ...) still works until it is disabled in Supabase.
# Leave the secret key on its default service_role role: the decrypt RPC is
# granted to service_role only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret authenticating klear_prescription_id metadata (PDPA-critical).
# The storefront's SERVER-side stamping paths sign the prescription id
# (klear_prescription_sig = base64url HMAC-SHA256(prescription_id)) AFTER
# proving the caller owns it (server-side ownership gate); buildLabJobPacket
# refuses to decrypt any prescription whose signature does not verify. MUST be the
# SAME value as the Website's KLEAR_RX_METADATA_SECRET. Do NOT reuse any
# other secret. Generate: openssl rand -base64 48. Store in Bitwarden.
# Missing → every Rx lab job fails closed (durable failed row, no decrypt).
KLEAR_RX_METADATA_SECRET=

# ── Carrier-status propagation to the storefront (H1) ──────────────────────
# The shippop-tracking subscriber POSTs shipped/delivered/etc. carrier updates
# to the storefront so the customer's order state + LINE/email fire.
#
# KLEAR_STOREFRONT_URL: base URL of the Next.js storefront (no trailing slash
#   needed). e.g. https://kleareyes.com (https; the production-state sender
#   refuses plain http except to localhost). Missing → subscriber logs once and
#   skips all POSTs (Medusa-side delivered marking still runs).
KLEAR_STOREFRONT_URL=
# KLEAR_CARRIER_WEBHOOK_SECRET: shared bearer secret sent as
#   `Authorization: Bearer <secret>` on every carrier-status POST. MUST match
#   the SAME value in the Website repo's KLEAR_CARRIER_WEBHOOK_SECRET. Generate:
#   openssl rand -base64 48. Store in Bitwarden. Missing → POSTs skipped.
KLEAR_CARRIER_WEBHOOK_SECRET=

# ── The Website: order production state and order cancel ──────────────────
# KLEAR_PROJECTION_SECRET: bearer secret sent as `Authorization: Bearer
#   <secret>` when the lab system posts an order's production state to the
#   Website's POST /api/webhooks/order-projection (contract 6). MUST match the
#   Website's KLEAR_PROJECTION_SECRET. At least 32 characters, and different
#   from every other Klear secret (KLEAR_CARRIER_WEBHOOK_SECRET included).
#   Sent to KLEAR_STOREFRONT_URL above. Unset, short or equal to another
#   secret → nothing is sent (the state is kept and sent once it is set).
#   Generate: openssl rand -base64 48.
KLEAR_PROJECTION_SECRET=
# KLEAR_ORDER_CANCEL_SECRET: bearer secret the Website sends to
#   POST /order-cancel/:id, which cancels one order that has no shipping
#   label yet and does nothing else (contract 7). MUST match the Website's
#   KLEAR_ORDER_CANCEL_SECRET. At least 32 characters; unset, shorter, or
#   equal to any other Klear secret here (the Operations secrets below,
#   KLEAR_PROJECTION_SECRET, KLEAR_CARRIER_WEBHOOK_SECRET,
#   KLEAR_RX_METADATA_SECRET) → the route answers 503 (closed by default).
#   Generate: openssl rand -base64 48.
KLEAR_ORDER_CANCEL_SECRET=

# ── Sentry error visibility (BACKLOG M5) ────────────────────────────────────
# SENTRY_DSN: DORMANT UNTIL SET — instrumentation.ts's register() calls
#   initSentry() (src/lib/observability/sentry.ts) at boot, which is a no-op
#   when this is unset. Local dev and any un-provisioned Railway environment
#   stay silent. Set on the Railway service to turn on error capture for the
#   H1 carrier subscriber, H5 heal job, and lab packet-build failures. A PDPA
#   scrubber (beforeSend/beforeBreadcrumb) redacts Rx fields, secrets, and
#   customer PII before any event leaves the process — see sentry.ts for the
#   denylist. Founder step: create the Sentry project, then set this + your
#   org's usual Sentry env vars on Railway.
SENTRY_DSN=

# ── Process role ────────────────────────────────────────────────────────────
# MEDUSA_WORKER_MODE: shared (default) | server | worker. "shared" runs the
#   HTTP server AND the background worker (subscribers, scheduled jobs) in one
#   process. To scale, run two Railway services from this repo: one "server",
#   one "worker".
MEDUSA_WORKER_MODE=

# ── Feed to Klear Operations ────────────────────────────────────────────────
# KLEAR_OPS_FEED_SECRET: bearer secret for the read-only /ops-feed/* routes
#   that Klear Operations polls. At least 32 characters. Used for nothing
#   else; it is not an admin key. Unset or shorter → every /ops-feed request
#   is answered 503 (closed by default). Generate: openssl rand -base64 48.
KLEAR_OPS_FEED_SECRET=
# KLEAR_STOCK_SYNC_SECRET: bearer secret for POST /ops-sync/frame-stock, where
#   Klear Operations reports frame on-hand and Medusa answers the difference
#   (report-only: it writes nothing). Opens that route only. At least 32
#   characters; unset or shorter → 503. The three Operations secrets must
#   all differ: if two are equal, the routes of both answer 503.
KLEAR_STOCK_SYNC_SECRET=
# KLEAR_LENS_SNAPSHOT_SECRET: bearer secret for POST /ops-sync/lens-stock,
#   where Klear Operations sends lens on-hand per SKU for the lab. Opens that
#   route only. At least 32 characters; unset or shorter → 503.
KLEAR_LENS_SNAPSHOT_SECRET=
# LMS_RELEASE_WEEKDAY: the weekday a lens-usage release window ends on,
#   0 (Sunday) to 6 (Saturday). Unset → Sunday. Windows also end on the last
#   day of every month.
LMS_RELEASE_WEEKDAY=

# ── Lab production ──────────────────────────────────────────────────────────
# LMS_REQUIRE_PACKED_BEFORE_LABEL: "true" refuses booking a shipping label
#   for an order whose lab job is not packed. LEAVE UNSET until the lab works
#   in the lab system's screens: before that no job ever reaches "packed",
#   and with this on no lens order could be shipped.
LMS_REQUIRE_PACKED_BEFORE_LABEL=
