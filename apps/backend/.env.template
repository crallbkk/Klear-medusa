# Supabase access for the LMS module's lab-handoff path. SERVICE_ROLE
# bypasses RLS — necessary because the lab handoff happens server-side
# in trusted Medusa workflows, not from a customer-scoped session.
# The decrypt_with_vault_key RPC + AES vault key live on the
# Supabase side; this server only needs the URL + key to call into them.
# RPC name: decrypt_with_vault_key(ciphertext text, key_alias text)
# Key alias used by LMS: "prescription_master_key" (see VAULT_KEYS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret authenticating klear_prescription_id metadata (PDPA-critical).
# The storefront's SERVER-side stamping paths sign the prescription id
# (klear_prescription_sig = base64url HMAC-SHA256(prescription_id)) AFTER
# proving the caller owns it (server-side ownership gate); buildLabJobPacket
# refuses to decrypt any prescription whose signature does not verify. MUST be the
# SAME value as the Website's KLEAR_RX_METADATA_SECRET. Do NOT reuse any
# other secret. Generate: openssl rand -base64 48. Store in Bitwarden.
# Missing → every Rx lab job fails closed (durable failed row, no decrypt).
KLEAR_RX_METADATA_SECRET=
