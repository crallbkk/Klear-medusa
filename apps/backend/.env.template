STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# LOCAL-DEV ONLY values. In production the server REFUSES TO BOOT if
# JWT_SECRET / COOKIE_SECRET are unset (medusa-config.ts requireSecret) —
# there is no "supersecret" fallback outside local dev. Set real values in
# the Railway service environment.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Supabase access for the LMS module's lab-handoff path. SERVICE_ROLE
# bypasses RLS — necessary because the lab handoff happens server-side
# in trusted Medusa workflows, not from a customer-scoped session.
# The decrypt_with_vault_key RPC + AES vault key live on the
# Supabase side; this server only needs the URL + key to call into them.
# RPC name: decrypt_with_vault_key(ciphertext text, key_alias text)
# Key alias used by LMS: "prescription_master_key" (see VAULT_KEYS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret authenticating klear_prescription_id metadata (PDPA-critical).
# The storefront's SERVER-side stamping paths sign the prescription id
# (klear_prescription_sig = base64url HMAC-SHA256(prescription_id)) AFTER
# proving the caller owns it (server-side ownership gate); buildLabJobPacket
# refuses to decrypt any prescription whose signature does not verify. MUST be the
# SAME value as the Website's KLEAR_RX_METADATA_SECRET. Do NOT reuse any
# other secret. Generate: openssl rand -base64 48. Store in Bitwarden.
# Missing → every Rx lab job fails closed (durable failed row, no decrypt).
KLEAR_RX_METADATA_SECRET=

# ── Carrier-status propagation to the storefront (H1) ──────────────────────
# The shippop-tracking subscriber POSTs shipped/delivered/etc. carrier updates
# to the storefront so the customer's order state + LINE/email fire.
#
# KLEAR_STOREFRONT_URL: base URL of the Next.js storefront (no trailing slash
#   needed). e.g. https://kleareyes.com. Missing → subscriber logs once and
#   skips all POSTs (Medusa-side delivered marking still runs).
KLEAR_STOREFRONT_URL=
# KLEAR_CARRIER_WEBHOOK_SECRET: shared bearer secret sent as
#   `Authorization: Bearer <secret>` on every carrier-status POST. MUST match
#   the SAME value in the Website repo's KLEAR_CARRIER_WEBHOOK_SECRET. Generate:
#   openssl rand -base64 48. Store in Bitwarden. Missing → POSTs skipped.
KLEAR_CARRIER_WEBHOOK_SECRET=

# ── Sentry error visibility (BACKLOG M5) ────────────────────────────────────
# SENTRY_DSN: DORMANT UNTIL SET — instrumentation.ts's register() calls
#   initSentry() (src/lib/observability/sentry.ts) at boot, which is a no-op
#   when this is unset. Local dev and any un-provisioned Railway environment
#   stay silent. Set on the Railway service to turn on error capture for the
#   H1 carrier subscriber, H5 heal job, and lab packet-build failures. A PDPA
#   scrubber (beforeSend/beforeBreadcrumb) redacts Rx fields, secrets, and
#   customer PII before any event leaves the process — see sentry.ts for the
#   denylist. Founder step: create the Sentry project, then set this + your
#   org's usual Sentry env vars on Railway.
SENTRY_DSN=
